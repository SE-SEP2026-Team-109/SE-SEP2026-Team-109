# Copy this file to ".env" (same folder) and change the values. ".env" is never committed.
# A long random string; generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string
# SQLite file used by default: backend/instance/mentorconnect.db
# DATABASE_URL=sqlite:///absolute/path/to/mentorconnect.db
JWT_EXPIRE_MINUTES=120
# Comma-separated list of frontend origins allowed to call the API directly (the Vite proxy does not need this)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# 1 = insert the demo data automatically when the database is empty
AUTO_SEED=1
